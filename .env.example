# --- Payload -------------------------------------------------------------
# Zufalls-String, z. B. mit: openssl rand -base64 32
PAYLOAD_SECRET=bitte-aendern-langer-zufallsstring

# Lokal eine Datei im Projekt, im Container das eingebundene Volume.
DATABASE_URI=file:./bulltron.db

# Verzeichnis für hochgeladene Bilder. Leer lassen für den Standard
# (public/media). Im Container: /data/media
# MEDIA_DIR=

# --- Site ----------------------------------------------------------------
# Steuert Canonicals, Sitemap und die Rücksprungadressen von Stripe.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Stripe --------------------------------------------------------------
# Auf Dev-Instanzen ausschließlich Testschlüssel verwenden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Passwortschutz für Dev- und Vorschau-Instanzen -----------------------
# Sobald beide gesetzt sind, verlangt die gesamte Seite eine Anmeldung.
# Ausgenommen bleiben der Stripe-Webhook und der Healthcheck.
# Für die Live-Instanz beide Zeilen leer lassen.
DEV_AUTH_USER=
DEV_AUTH_PASSWORD=

# --- Shop sichtbar? ------------------------------------------------------
# false blendet Warenkorb, Kasse, Preis-Buttons und die Zahlungshinweise aus.
# Die Produktseiten verweisen dann auf Telefon und E-Mail. Auf true stellen,
# sobald die Stripe-Schlüssel eingetragen sind.
NEXT_PUBLIC_SHOP_ENABLED=false

# E-Mail-Versand der Bestellbestätigung.
# Ohne SMTP_HOST und MAIL_FROM bleibt der Adapter aus und Payload schreibt Mails
# nur ins Protokoll. Für die Entwicklung gewollt, für den Livebetrieb nicht:
# die AGB sagen die Bestätigung des Bestelleingangs zu, § 312i BGB verlangt sie.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=BULLTRON RACE
# Leer lassen: dann geht die interne Benachrichtigung an die E-Mail-Adresse aus
# den Website-Einstellungen.
MAIL_SHOP=
